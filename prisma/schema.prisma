
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  MENTOR
}

enum ProjectStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project          Project?  @relation("StudentProject")
  reviewedProjects Project[] @relation("ProjectReviewer")
}

model Project {
  id          String        @id @default(uuid())
  name        String
  repoUrl     String
  liveUrl     String?
  description String
  status      ProjectStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  reviewedAt  DateTime?

  studentId String @unique
  student   User   @relation("StudentProject", fields: [studentId], references: [id], onDelete: Cascade)

  reviewedById String?
  reviewedBy   User?   @relation("ProjectReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([createdAt])
}
